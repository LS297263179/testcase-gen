# ============================================================
# AI 测试工程平台 - 环境变量配置
# 复制此文件为 .env 并填入你的配置
# ============================================================

# Flask session 加密密钥（必填，重启后保持登录状态）
# 它只影响 session：库里 api_key 的解密主密钥在首次启动时就写进了 settings._fernet_key，
# 所以换这把密钥只会让所有人重新登录一次，不会让已保存的 Key 变砖。
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-secret-key-here

# ---------- 公共实例（免登录）----------
# 1 = 打开页面即以共享访客身份进入主界面，登录/注册页不再出现，/api/register 同步关闭。
#     代价：所有访客共用同一个数据空间，彼此可见并可删改对方的素材/测试点/用例。
GUEST_AUTO_LOGIN=0

# 共享访客账号的用户名（首次请求时幂等创建，密码随机生成，无人需要知道）
GUEST_USERNAME=shared

# 1 = 免登录时锁定模型配置写入（POST /api/model-config → 403）。
#     不锁的话访客能把 base_url 改成自己的网关，等于把需求原文外发给第三方。
GUEST_LOCK_CONFIG=0

# ---------- 构建参数（docker compose build 读取）----------
# 国内服务器构建慢/超时时可改用镜像源
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# DEBIAN_MIRROR=mirrors.aliyun.com

# ---------- 端口发布 ----------
# 默认 127.0.0.1:5000，需由反向代理对外提供服务（推荐：TLS 由 Nginx/Caddy 终结）。
# 没有反代、要容器直接对公网开放时：PUBLISH_ADDR=0.0.0.0 + HTTP_PORT=80
# 注意 gunicorn 不做 TLS，443 需要证书方案先落地。
# PUBLISH_ADDR=127.0.0.1
# HTTP_PORT=5000

# ---------- 直连 TLS（无独立反代时才用）----------
# 叠加 docker-compose.tls.yml：让 gunicorn 自己听 443（需证书目录 ./certs）。
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# gunicorn 的 ssl:// 监听依赖 pyopenssl，构建时追加：
# PIP_EXTRA=pyopenssl
